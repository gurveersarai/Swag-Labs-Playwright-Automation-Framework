  "scripts" : {
    "pretest": "ts-node scripts/write-allure-env.ts",
     "test": "playwright test",
     "allure:generate" : "npx allure generate allure-results -o allure-report",
     "allure:open": "npx allure open allure-report",
     "allure:report": "npm run allure:generate && npm run allure:open",
     "ci": "npm run pretest && npm run test && npm run allure:report",
     "deploy:allure": "gh-pages -d allure-report -b gh-pages"
  }
